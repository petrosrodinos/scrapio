generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OPENAPI_SPEC
  OTHER
}

enum WorkflowType {
  SCRAPER
  BROWSER_AGENT
  PLAIN_SCRAPE
}

enum ScraperStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  TESTING
  BROKEN
}

// A non-empty subset is expected wherever this is used (STRUCTURED_JSON, MARKDOWN, or both) —
// validated at the application layer, since Postgres array columns cannot enforce "non-empty" directly.
enum OutputFormat {
  STRUCTURED_JSON
  MARKDOWN
}

// How multiple URLs supplied to a plain scrape are treated for STRUCTURED_JSON/MARKDOWN normalization.
enum ExtractionScope {
  COMBINED
  PER_URL
}

// Per-format validation outcome on an ExtractionResult. STRUCTURED_JSON and MARKDOWN fail independently.
enum ExtractionFormatStatus {
  VALID
  INVALID
  FAILED
}

// How an execution run was started.
enum RunTrigger {
  MANUAL
  SCHEDULED
}

enum ScraperHealth {
  EXCELLENT
  GOOD
  WARNING
  CRITICAL
  BROKEN
}

// Shared execution status across all three workflow types.
enum RunStatus {
  QUEUED
  RUNNING
  // Raw scrape/crawl/browse finished; structured-JSON extraction was handed off to an AI batch
  // job (see AiBatchJob) instead of run immediately. Parked here until the batch completes.
  AWAITING_AI_BATCH
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

enum AiBatchJobStatus {
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum DiagnosticsMode {
  PRODUCTION
  TRACE
  FULL_DEBUG
}

enum DiagnosticsArtifactKind {
  TRACE
  SCREENSHOT
  HTML_SNAPSHOT
  CONSOLE_LOG
  NETWORK_HAR
  VIDEO
}

enum GenerationRunStatus {
  DRAFT
  QUEUED
  RUNNING
  AWAITING_REVIEW
  SUCCESS
  FAILED
  CANCELLED
}

enum GenerationTrigger {
  MANUAL
  SELF_HEAL
  SCHEDULED
}

enum ComputerActionType {
  CLICK
  DOUBLE_CLICK
  TYPE
  SCROLL
  SCROLL_UP
  SCROLL_DOWN
  NAVIGATE
  GO_BACK
  CLOSE_TAB
  WAIT
  KEYPRESS
  SCREENSHOT
  DRAG
  INSPECT_DOM
  PROBE_SELECTORS
  DONE
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
  STALLED
}

enum ScraperVersionCreatedBy {
  AI
  USER
}

enum BlockSignal {
  BLOCKED
  CHALLENGE
}

enum BlockRuleSource {
  TITLE
  TEXT
  HTML
  PATH
  SCRIPT_CONTENT
  SELECTOR
}

// Covers all three workflows: reusable scrapers, browser agent runs, and plain scrape runs.
enum NotificationType {
  QUEUE_FAILURE
  BROKEN_SCRAPER
  WEBSITE_UNAVAILABLE
  LARGE_CRAWL_FAILURE
  BROWSER_AGENT_FAILURE
  PLAIN_SCRAPE_FAILURE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IntegrationType {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
}

enum WebhookEventType {
  WORKFLOW_RUN_QUEUED
  WORKFLOW_RUN_RUNNING
  // Non-terminal: fired when structured-JSON extraction is handed off to an OpenAI batch job
  // instead of running immediately. The real completion event fires later, at batch completion.
  WORKFLOW_RUN_AI_BATCH_SUBMITTED
  WORKFLOW_RUN_SUCCEEDED
  WORKFLOW_RUN_PARTIAL_SUCCESS
  WORKFLOW_RUN_FAILED
  WORKFLOW_RUN_CANCELLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ComputerUseModel {
  CLAUDE_OPUS_4_8
  CLAUDE_SONNET_4_6
  COMPUTER_USE_PREVIEW
  GPT_4O
  GPT_4O_MINI
  GPT_4_TURBO
  GPT_4
  GPT_35_TURBO
  GEMINI_2_5_PRO
  GEMINI_2_5_FLASH
  GEMINI_2_0_FLASH
  GEMINI_1_5_PRO
  GEMINI_1_5_FLASH
  DEEPSEEK_CHAT
  DEEPSEEK_REASONER
}

// One value per billable AI operation, not per provider — extend with new values as future cost
// sources (storage, third-party APIs, etc.) come online.
enum CostCategory {
  STRUCTURED_EXTRACTION // AI generates structured JSON matching an extraction schema
  MARKDOWN_GENERATION // AI normalizes scraped content into a Markdown document
  EMBEDDING // AI generates vector embeddings for search indexing
  BROWSER_AGENT_RUN // Computer-use agent autonomously navigates a page to collect findings
  SCRAPER_GENERATION // Computer-use agent builds/verifies a scraper config during generation
  UI_GENERATION // AI renders structured JSON extraction output as a self-contained HTML/CSS interface
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  phone               String?  @unique
  password            String
  role                AuthRole
  default_schedule_tz String   @default("Europe/Athens")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  password_reset_tokens PasswordResetToken[]
  website_targets       WebsiteTarget[]
  workflow_configs      WorkflowConfig[]
  workflow_runs         WorkflowRun[]
  user_integrations     UserIntegration[]
  extraction_schemas    ExtractionSchema[]
  api_keys              ApiKey[]
  webhook_endpoints     WebhookEndpoint[]
  webhook_deliveries    WebhookDelivery[]
  job_logs              JobLog[]
  diagnostics_packages  DiagnosticsPackage[]
  notifications         Notification[]
  cost_entries          CostEntry[]
  scraper_versions          ScraperVersion[]
  scraper_generation_runs   ScraperGenerationRun[]
  computer_use_steps        ComputerUseStep[]
  scraper_execution_traces  ScraperExecutionTrace[]
  extracted_items           ExtractedItem[]
  plain_scraped_pages       PlainScrapedPage[]
  extraction_results        ExtractionResult[]
  ai_batch_request_items    AiBatchRequestItem[]
  block_rules               BlockRule[]

  @@index([email])
  @@index([phone])
  @@index([id])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_id    String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model ApiKey {
  id           String    @id @default(uuid())
  user_id      String
  name         String
  key_prefix   String
  key_hash     String    @unique
  is_active    Boolean   @default(true)
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("api_keys")
}

model WebhookEndpoint {
  id                String             @id @default(uuid())
  user_id           String
  name              String?
  url               String
  // Reversible AES-256-GCM ciphertext (NOT a one-way hash) — the delivery worker needs the
  // plaintext secret back on every outbound request to compute the HMAC signature.
  secret_encrypted  String
  subscribed_events WebhookEventType[]
  is_active         Boolean            @default(true)
  last_triggered_at DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([user_id])
  @@index([is_active])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                  String                @id @default(uuid())
  webhook_endpoint_id String
  user_id             String
  event_type          WebhookEventType
  // Plain string, no FK — delivery history must survive WorkflowRun pruning/deletion.
  workflow_run_id     String?
  is_test             Boolean               @default(false)
  payload             Json
  status              WebhookDeliveryStatus @default(PENDING)
  http_status_code    Int?
  response_body       String?
  error_message       String?
  attempt_number      Int                   @default(1)
  duration_ms         Int?
  created_at          DateTime              @default(now())

  webhook_endpoint WebhookEndpoint @relation(fields: [webhook_endpoint_id], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([webhook_endpoint_id])
  @@index([webhook_endpoint_id, created_at])
  @@index([status])
  @@index([user_id])
  @@map("webhook_deliveries")
}

model Document {
  id         String       @id @default(uuid())
  user_id    String
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  type       DocumentType @default(LOGO)
  created_at DateTime     @default(now())

  computer_use_steps_before ComputerUseStep[] @relation("ComputerUseStepScreenshotBefore")
  computer_use_steps_after  ComputerUseStep[] @relation("ComputerUseStepScreenshotAfter")
  workflow_run_openapi_spec WorkflowRun[]     @relation("WorkflowRunOpenApiSpec")

  @@index([user_id])
  @@index([id])
  @@map("documents")
}

model WebsiteTarget {
  id                                   String    @id @default(uuid())
  user_id                              String
  name                                 String
  base_url                             String
  notes                                String?
  last_success_at                      DateTime?
  last_failure_at                      DateTime?
  last_error_message                   String?
  metadata                             Json?
  block_handling_wait_timeout_ms       Int?
  block_handling_min_ready_body_length Int?
  created_at                           DateTime  @default(now())
  updated_at                           DateTime  @updatedAt

  user                    User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workflow_configs        WorkflowConfig[]
  scraper_generation_runs ScraperGenerationRun[]
  workflow_runs           WorkflowRun[]
  block_rules             BlockRule[]
  notifications           Notification[]
  extracted_items         ExtractedItem[]

  @@unique([user_id, base_url])
  @@index([user_id])
  @@map("website_targets")
}

model BlockRule {
  id                String          @id @default(uuid())
  website_target_id String
  user_id           String
  label             String?
  signal            BlockSignal
  source            BlockRuleSource
  pattern           String
  is_regex          Boolean         @default(false)
  regex_flags       String?
  position          Int             @default(0)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  website_target WebsiteTarget @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([website_target_id])
  @@index([user_id])
  @@map("block_rules")
}

// ---------------------------------------------------------------------------
// Unified Workflow Configuration
//
// Replaces Scraper + BrowserAgentConfig + PlainScrapeConfig. The `type` field
// acts as a discriminator — only fields relevant to that type are populated.
// ---------------------------------------------------------------------------

model WorkflowConfig {
  id          String       @id @default(uuid())
  user_id     String
  type        WorkflowType
  name        String
  description String?

  // ── SCRAPER only ──────────────────────────────────────────────────────────
  website_target_id    String?
  active_version_id    String?         @unique
  version_count        Int             @default(0)
  status               ScraperStatus?
  self_healing_enabled Boolean         @default(true)
  diagnostics_mode     DiagnosticsMode @default(PRODUCTION)
  health               ScraperHealth?
  success_rate         Decimal?        @db.Decimal(5, 2)
  avg_runtime_ms       Int?
  consecutive_failures Int             @default(0)
  last_success_at      DateTime?
  last_failure_at      DateTime?

  // ── BROWSER_AGENT only ────────────────────────────────────────────────────
  url          String?
  max_steps    Int?    @default(25)
  // When true, every HTTP request/response the agent's browser makes during the run is
  // recorded and, on completion, distilled into an OpenAPI spec (see WorkflowRun.captured_requests
  // / openapi_spec_document_id).
  capture_api  Boolean @default(false)

  // ── PLAIN_SCRAPE only ─────────────────────────────────────────────────────
  urls             String[]
  extraction_scope ExtractionScope @default(COMBINED)

  // ── BROWSER_AGENT + PLAIN_SCRAPE: output contract ─────────────────────────
  output_formats               OutputFormat[]
  extraction_schema_version_id String?

  // ── Scheduling (all types) ────────────────────────────────────────────────
  schedule_cron     String?
  schedule_timezone String?
  schedule_enabled  Boolean @default(false)

  // When false, runs of this config ("scrape and forget") have their result payloads deleted
  // once a subscribed webhook endpoint confirms delivery — see WorkflowRun.persist_results.
  persist_results Boolean @default(true)

  // When true, STRUCTURED_JSON extraction is submitted to an OpenAI batch job instead of run
  // immediately (see AiBatchJob). Only meaningful when output_formats includes STRUCTURED_JSON
  // and an extraction schema is linked (WorkflowConfig.extraction_schema_version_id for
  // BROWSER_AGENT/PLAIN_SCRAPE, or the active ScraperVersion's for SCRAPER); ignored otherwise.
  ai_batch_mode Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  website_target            WebsiteTarget?           @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  active_version            ScraperVersion?          @relation("ActiveVersion", fields: [active_version_id], references: [id], onDelete: SetNull)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)

  runs                    WorkflowRun[]
  versions                ScraperVersion[]        @relation("ScraperVersions")
  execution_traces        ScraperExecutionTrace[]
  scraper_generation_runs ScraperGenerationRun[]
  notifications           Notification[]
  diagnostics_packages    DiagnosticsPackage[]

  @@index([user_id])
  @@index([type])
  @@index([website_target_id])
  @@index([status])
  @@index([health])
  @@map("workflow_configs")
}

model ScraperGenerationRun {
  id                  String              @id @default(uuid())
  website_target_id   String
  workflow_config_id  String?
  user_id             String
  trigger             GenerationTrigger   @default(MANUAL)
  status              GenerationRunStatus @default(QUEUED)
  prompt              String?
  max_steps           Int?
  output_formats      OutputFormat[]
  output_schema       Json?
  staged_config       Json?
  produced_version_id String?             @unique
  error_message       String?
  started_at          DateTime?
  finished_at         DateTime?
  duration_ms         Int?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  website_target   WebsiteTarget   @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  workflow_config  WorkflowConfig? @relation(fields: [workflow_config_id], references: [id], onDelete: SetNull)
  produced_version ScraperVersion? @relation("ProducedVersion", fields: [produced_version_id], references: [id], onDelete: SetNull)
  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  steps ComputerUseStep[]

  @@index([website_target_id])
  @@index([workflow_config_id])
  @@index([status])
  @@index([user_id])
  @@map("scraper_generation_runs")
}

// A single Computer Use step, belonging to exactly one of: a ScraperGenerationRun (discovering
// how to build a reusable scraper) or a WorkflowRun of type BROWSER_AGENT.
model ComputerUseStep {
  id                        String             @id @default(uuid())
  scraper_generation_run_id String?
  workflow_run_id           String?
  user_id                   String
  step_index                Int
  action_type               ComputerActionType
  action_payload            Json
  screenshot_before_id      String?
  screenshot_after_id       String?
  model_reasoning           String?
  created_at                DateTime           @default(now())

  scraper_generation_run ScraperGenerationRun? @relation(fields: [scraper_generation_run_id], references: [id], onDelete: Cascade)
  workflow_run           WorkflowRun?          @relation(fields: [workflow_run_id], references: [id], onDelete: Cascade)
  screenshot_before      Document?             @relation("ComputerUseStepScreenshotBefore", fields: [screenshot_before_id], references: [id], onDelete: SetNull)
  screenshot_after       Document?             @relation("ComputerUseStepScreenshotAfter", fields: [screenshot_after_id], references: [id], onDelete: SetNull)
  user                   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([scraper_generation_run_id])
  @@index([scraper_generation_run_id, step_index])
  @@index([workflow_run_id])
  @@index([workflow_run_id, step_index])
  @@index([user_id])
  @@map("computer_use_steps")
}

model ScraperVersion {
  id                 String                  @id @default(uuid())
  workflow_config_id String
  user_id            String
  version            Int
  // Fixed/reusable scraper configuration or sequence of scraper steps (Computer-Use-generated
  // or CSS-selector-based) produced from generation_prompt. Opaque to Prisma by design.
  config             Json
  created_by         ScraperVersionCreatedBy
  notes              String?

  // Free-text scraper-generation instructions this version was built from. Reused verbatim as the
  // guiding prompt for MARKDOWN normalization at execution time — kept on the version (not just the
  // generation run) so it stays available even when the producing ScraperGenerationRun is pruned.
  generation_prompt String?

  // Output contract this version is expected to produce. STRUCTURED_JSON requires
  // extraction_schema_version_id; MARKDOWN needs no schema. Both may be set.
  output_formats               OutputFormat[]
  extraction_schema_version_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workflow_config           WorkflowConfig           @relation("ScraperVersions", fields: [workflow_config_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  active_for_config WorkflowConfig?       @relation("ActiveVersion")
  produced_by_run   ScraperGenerationRun? @relation("ProducedVersion")
  workflow_runs     WorkflowRun[]

  @@unique([workflow_config_id, version])
  @@index([extraction_schema_version_id])
  @@index([user_id])
  @@map("scraper_versions")
}

model ScraperExecutionTrace {
  id                 String   @id @default(uuid())
  workflow_config_id String
  workflow_run_id    String?
  user_id            String
  steps              Json
  success            Boolean
  error_summary      String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  workflow_config WorkflowConfig @relation(fields: [workflow_config_id], references: [id], onDelete: Cascade)
  workflow_run    WorkflowRun?   @relation(fields: [workflow_run_id], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([workflow_config_id])
  @@index([user_id])
  @@map("scraper_execution_traces")
}

// ---------------------------------------------------------------------------
// Unified Workflow Run
//
// Replaces CrawlRun + BrowserAgentRun + PlainScrapeRun. The `type` field
// mirrors the parent WorkflowConfig type and acts as a discriminator.
// ---------------------------------------------------------------------------

model WorkflowRun {
  id                 String       @id @default(uuid())
  workflow_config_id String
  user_id            String
  type               WorkflowType
  trigger            RunTrigger   @default(MANUAL)
  status             RunStatus    @default(QUEUED)

  // ── SCRAPER run ───────────────────────────────────────────────────────────
  website_target_id  String?
  // Exact ScraperVersion this run executed against — pins the config, generation_prompt,
  // output_formats, and extraction_schema_version_id for this run, independently of whatever
  // version the WorkflowConfig's active_version_id later points to.
  scraper_version_id String?

  // ── BROWSER_AGENT run ─────────────────────────────────────────────────────
  url             String?
  max_steps       Int?
  visited_urls    Json?
  browser_actions Json?
  collected_data  Json?

  // Snapshotted from WorkflowConfig.capture_api at enqueue time. When true, captured_requests
  // holds every recorded HTTP request/response and openapi_spec_document_id points at the
  // Document generated from them once the run finishes.
  capture_api             Boolean @default(false)
  captured_requests       Json?
  openapi_spec_document_id String?

  // ── PLAIN_SCRAPE run ──────────────────────────────────────────────────────
  urls             String[]
  extraction_scope ExtractionScope?

  // ── BROWSER_AGENT + PLAIN_SCRAPE: snapshot of the config's contract ───────
  output_formats               OutputFormat[]
  extraction_schema_version_id String?

  // Snapshotted from WorkflowConfig.ai_batch_mode at enqueue time.
  ai_batch_mode Boolean @default(false)

  // ── Common ────────────────────────────────────────────────────────────────
  ai_usage      Json?
  error_message String?
  metadata      Json?

  // Snapshotted from WorkflowConfig.persist_results at enqueue time. When false, result
  // payloads (raw_html, structured_data, markdown, collected_data) are deleted once a
  // subscribed webhook endpoint confirms delivery, or by the fallback retention cron.
  persist_results   Boolean   @default(true)
  results_purged_at DateTime?

  started_at  DateTime?
  finished_at DateTime?
  duration_ms Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  workflow_config           WorkflowConfig           @relation(fields: [workflow_config_id], references: [id], onDelete: Cascade)
  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  website_target            WebsiteTarget?           @relation(fields: [website_target_id], references: [id], onDelete: SetNull)
  scraper_version           ScraperVersion?          @relation(fields: [scraper_version_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  openapi_spec_document     Document?                @relation("WorkflowRunOpenApiSpec", fields: [openapi_spec_document_id], references: [id], onDelete: SetNull)

  steps               ComputerUseStep[]
  job_logs            JobLog[]
  notifications       Notification[]
  diagnostics_package DiagnosticsPackage?
  extracted_items     ExtractedItem[]
  execution_traces    ScraperExecutionTrace[]
  pages               PlainScrapedPage[]
  extraction_result   ExtractionResult?
  ai_batch_job        AiBatchJob?
  cost_entries        CostEntry[]

  @@index([workflow_config_id])
  @@index([user_id])
  @@index([type])
  @@index([website_target_id])
  @@index([scraper_version_id])
  @@index([status])
  @@index([created_at])
  @@index([extraction_schema_version_id])
  @@map("workflow_runs")
}

model ExtractedItem {
  id                String   @id @default(uuid())
  website_target_id String
  workflow_run_id   String?
  user_id           String
  source_url        String
  external_id       String?
  raw_data          Json
  content_hash      String?
  first_seen_at     DateTime @default(now())
  last_seen_at      DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  website_target WebsiteTarget @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  workflow_run   WorkflowRun?  @relation(fields: [workflow_run_id], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([website_target_id, source_url])
  @@index([workflow_run_id])
  @@index([user_id])
  @@map("extracted_items")
}

// ---------------------------------------------------------------------------
// App-Defined Output Schema (Shared Concept)
//
// Reusable, user-owned, versioned representation of the expected STRUCTURED_JSON output shape.
// Referenced (never duplicated) by whichever workflow needs it: ScraperVersion, WorkflowConfig,
// WorkflowRun. Versions are immutable — a config's FK is free to move to a newer version, but
// each run snapshots the version it actually executed against, so changing a schema later can
// never make a historical run's result ambiguous.
// ---------------------------------------------------------------------------

model ExtractionSchema {
  id                String   @id @default(uuid())
  user_id           String
  name              String
  description       String?
  active_version_id String?  @unique
  version_count     Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user           User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_version ExtractionSchemaVersion?  @relation("ActiveExtractionSchemaVersion", fields: [active_version_id], references: [id], onDelete: SetNull)
  versions       ExtractionSchemaVersion[] @relation("ExtractionSchemaVersions")

  @@index([user_id])
  @@map("extraction_schemas")
}

model ExtractionSchemaVersion {
  id                   String   @id @default(uuid())
  extraction_schema_id String
  version              Int
  // The application-level schema representation: a dynamic, user-defined map of field name ->
  // { type: string | number | integer | boolean | string[] | number[] | boolean[] | object |
  //          object[] | enum | ..., description?, required?, nullable?, enum?, pattern?,
  //          minimum?, maximum?, minLength?, maxLength?, items? (array element schema),
  //          properties? (nested object schema) }.
  // Converted to the AI provider's structured-output/JSON Schema format at execution time —
  // never hardcoded around specific fields.
  definition           Json
  created_at           DateTime @default(now())

  extraction_schema ExtractionSchema  @relation("ExtractionSchemaVersions", fields: [extraction_schema_id], references: [id], onDelete: Cascade)
  active_for_schema ExtractionSchema? @relation("ActiveExtractionSchemaVersion")

  scraper_versions   ScraperVersion[]
  workflow_configs   WorkflowConfig[]
  workflow_runs      WorkflowRun[]
  extraction_results ExtractionResult[]

  @@unique([extraction_schema_id, version])
  @@map("extraction_schema_versions")
}

// Raw per-URL fetch result — always populated, independently of whether normalization was requested.
model PlainScrapedPage {
  id              String   @id @default(uuid())
  workflow_run_id String
  user_id         String
  requested_url   String
  final_url       String?
  http_status     Int?
  success         Boolean  @default(false)
  raw_html        String?
  cleaned_content String?
  title           String?
  metadata        Json?
  error_message   String?
  created_at      DateTime @default(now())

  workflow_run      WorkflowRun       @relation(fields: [workflow_run_id], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // Populated when the parent run's extraction_scope is PER_URL (one result per page).
  extraction_result ExtractionResult?

  // Populated when the parent run's extraction_scope is PER_URL and ai_batch_mode is enabled —
  // one AiBatchRequestItem per page, all submitted together as a single AiBatchJob for the run.
  ai_batch_request_items AiBatchRequestItem[]

  @@index([workflow_run_id])
  @@index([user_id])
  @@map("plain_scraped_pages")
}

// ---------------------------------------------------------------------------
// Structured Extraction Pipeline (Shared Concept): normalized results
//
// One row per "thing that got normalized" — a SCRAPER WorkflowRun, a BROWSER_AGENT WorkflowRun,
// a COMBINED PLAIN_SCRAPE WorkflowRun, or a single PlainScrapedPage under a PER_URL run.
// STRUCTURED_JSON and MARKDOWN are independently-failable outputs — either, both, or (on total
// failure) neither payload may be present.
// ---------------------------------------------------------------------------

model ExtractionResult {
  id String @id @default(uuid())

  workflow_run_id       String? @unique
  plain_scraped_page_id String? @unique
  user_id               String

  // The exact schema version this result was validated against (STRUCTURED_JSON only).
  extraction_schema_version_id String?

  structured_status            ExtractionFormatStatus?
  structured_data              Json?
  // Last generated (possibly still-invalid) output, preserved for debugging even on failure.
  structured_raw_ai_output     Json?
  structured_validation_errors Json?
  structured_attempts          Int                     @default(0)

  markdown_status            ExtractionFormatStatus?
  markdown                   String?
  markdown_validation_errors Json?

  // Self-contained HTML+CSS document that renders structured_data as a visual interface.
  generated_ui_html String? @db.Text

  ai_usage   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workflow_run              WorkflowRun?             @relation(fields: [workflow_run_id], references: [id], onDelete: Cascade)
  plain_scraped_page        PlainScrapedPage?        @relation(fields: [plain_scraped_page_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([extraction_schema_version_id])
  @@index([user_id])
  @@map("extraction_results")
}

// ---------------------------------------------------------------------------
// AI Batch Extraction (OpenAI only)
//
// When a config has ai_batch_mode enabled, STRUCTURED_JSON extraction for a run is submitted to
// an OpenAI batch job (one AiBatchJob per WorkflowRun) instead of run immediately. AiBatchJob
// tracks the external batch; AiBatchRequestItem tracks each individual line item within it — one
// per WorkflowRun-level extraction (SCRAPER, BROWSER_AGENT, COMBINED PLAIN_SCRAPE), or one per
// page for a PER_URL PLAIN_SCRAPE run.
// ---------------------------------------------------------------------------

model AiBatchJob {
  id              String @id @default(uuid())
  workflow_run_id String @unique
  user_id         String

  external_batch_id String
  input_file_id     String
  output_file_id    String?
  error_file_id     String?
  status            AiBatchJobStatus @default(SUBMITTED)
  request_count     Int
  error_message     String?

  submitted_at   DateTime  @default(now())
  completed_at   DateTime?
  last_polled_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  workflow_run WorkflowRun          @relation(fields: [workflow_run_id], references: [id], onDelete: Cascade)
  items        AiBatchRequestItem[]

  @@index([status])
  @@index([user_id])
  @@map("ai_batch_jobs")
}

model AiBatchRequestItem {
  id              String @id @default(uuid())
  ai_batch_job_id String
  user_id         String
  // Matches the "custom_id" of the corresponding line in the OpenAI batch request/response file.
  custom_id       String

  plain_scraped_page_id String?
  source_url            String?
  content_label         String?
  // Raw evidence sent to the model — same content/cap as the immediate-mode extraction path.
  content               String
  instructions          String?
  wants_markdown        Boolean @default(false)
  // Deterministically-extracted "regex" schema fields, merged back into the AI's output at
  // completion time (mirrors ExtractionService.runStructuredExtraction's regex-field handling).
  regex_data            Json?

  // Null until the batch completes and this item's response has been validated.
  status ExtractionFormatStatus?

  created_at DateTime @default(now())

  ai_batch_job       AiBatchJob        @relation(fields: [ai_batch_job_id], references: [id], onDelete: Cascade)
  plain_scraped_page PlainScrapedPage? @relation(fields: [plain_scraped_page_id], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([ai_batch_job_id, custom_id])
  @@index([user_id])
  @@map("ai_batch_request_items")
}

model DiagnosticsPackage {
  id                 String          @id @default(uuid())
  workflow_run_id    String          @unique
  workflow_config_id String
  user_id            String?
  mode               DiagnosticsMode
  url                String
  worker_id          String?
  browser_version    String?
  playwright_version String?
  scraper_version    Int?
  retry_number       Int?
  started_at         DateTime
  finished_at        DateTime
  duration_ms        Int
  failure_reason     String?
  exception          String?
  created_at         DateTime        @default(now())

  workflow_run    WorkflowRun           @relation(fields: [workflow_run_id], references: [id], onDelete: Cascade)
  workflow_config WorkflowConfig        @relation(fields: [workflow_config_id], references: [id], onDelete: Cascade)
  user            User?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)
  artifacts       DiagnosticsArtifact[]

  @@index([workflow_config_id])
  @@index([user_id])
  @@map("diagnostics_packages")
}

model DiagnosticsArtifact {
  id                     String                  @id @default(uuid())
  diagnostics_package_id String
  kind                   DiagnosticsArtifactKind
  path                   String
  content_type           String
  size_bytes             Int
  created_at             DateTime                @default(now())

  diagnostics_package DiagnosticsPackage @relation(fields: [diagnostics_package_id], references: [id], onDelete: Cascade)

  @@index([diagnostics_package_id])
  @@map("diagnostics_artifacts")
}

// Queue job tracking for all workflow types. workflow_run_id links to the unified WorkflowRun.
model JobLog {
  id              String    @id @default(uuid())
  queue_name      String
  job_id          String?
  job_name        String?
  status          JobStatus
  attempt         Int       @default(0)
  max_attempts    Int?
  workflow_run_id String?
  user_id         String
  payload         Json?
  result          Json?
  error_message   String?
  stack_trace     String?
  started_at      DateTime?
  finished_at     DateTime?
  duration_ms     Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  workflow_run WorkflowRun? @relation(fields: [workflow_run_id], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([queue_name])
  @@index([job_id])
  @@index([status])
  @@index([workflow_run_id])
  @@index([user_id])
  @@index([created_at])
  @@map("job_logs")
}

// Generic ledger of metered costs incurred on a user's behalf (AI generation, computer-use
// agent runs, and future categories). Each row is one billable event; aggregate with
// groupBy(user_id, category) for summaries instead of maintaining running totals elsewhere.
model CostEntry {
  id              String       @id @default(uuid())
  user_id         String
  category        CostCategory
  provider        String?
  model           String?
  amount          Decimal      @db.Decimal(12, 6)
  currency        String       @default("USD")
  workflow_run_id String?
  metadata        Json?
  created_at      DateTime     @default(now())

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workflow_run WorkflowRun? @relation(fields: [workflow_run_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([category])
  @@index([user_id, category])
  @@index([workflow_run_id])
  @@index([created_at])
  @@map("cost_entries")
}

// System notifications for all three workflow types.
model Notification {
  id                 String               @id @default(uuid())
  type               NotificationType
  severity           NotificationSeverity @default(INFO)
  title              String
  message            String
  website_target_id  String?
  workflow_config_id String?
  workflow_run_id    String?
  user_id            String?
  is_read            Boolean              @default(false)
  created_at         DateTime             @default(now())

  website_target  WebsiteTarget?  @relation(fields: [website_target_id], references: [id], onDelete: SetNull)
  workflow_config WorkflowConfig? @relation(fields: [workflow_config_id], references: [id], onDelete: SetNull)
  workflow_run    WorkflowRun?    @relation(fields: [workflow_run_id], references: [id], onDelete: SetNull)
  user            User?           @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([severity])
  @@index([is_read])
  @@index([created_at])
  @@index([user_id])
  @@map("notifications")
}

model UserIntegration {
  id                    String            @id @default(uuid())
  user_id               String
  integration_type      IntegrationType
  computer_use_model    ComputerUseModel?
  ai_model              ComputerUseModel?
  credentials_encrypted String
  is_active             Boolean           @default(true)
  is_default            Boolean           @default(false)
  metadata              Json?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, integration_type])
  @@index([user_id])
  @@index([integration_type])
  @@index([is_active])
  @@index([user_id, is_default])
  @@map("user_integrations")
}

model PlatformConfig {
  id                                           String   @id @default("singleton")
  crawler_max_pages                            Int?
  crawler_page_timeout_ms                      Int?
  crawler_selector_timeout_ms                  Int?
  crawler_scroll_pause_ms                      Int?
  crawler_detail_concurrency                   Int?
  crawler_detail_delay_ms                      Int?
  crawler_worker_concurrency                   Int?
  crawler_job_timeout_ms                       Int?
  crawler_chromium_max_contexts_before_restart Int?
  created_at                                   DateTime @default(now())
  updated_at                                   DateTime @updatedAt

  @@map("platform_config")
}
