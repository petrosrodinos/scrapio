generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum ScraperStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  TESTING
  BROKEN
}

// A non-empty subset is expected wherever this is used (STRUCTURED_JSON, MARKDOWN, or both) —
// validated at the application layer, since Postgres array columns cannot enforce "non-empty" directly.
enum OutputFormat {
  STRUCTURED_JSON
  MARKDOWN
}

// How multiple URLs supplied to a plain scrape are treated for STRUCTURED_JSON/MARKDOWN normalization.
enum ExtractionScope {
  COMBINED
  PER_URL
}

// Per-format validation outcome on an ExtractionResult. STRUCTURED_JSON and MARKDOWN fail independently.
enum ExtractionFormatStatus {
  VALID
  INVALID
  FAILED
}

// How an execution run (CrawlRun / BrowserAgentRun / PlainScrapeRun) was started.
enum RunTrigger {
  MANUAL
  SCHEDULED
}

enum ScraperHealth {
  EXCELLENT
  GOOD
  WARNING
  CRITICAL
  BROKEN
}

// Shared execution status for CrawlRun, BrowserAgentRun, and PlainScrapeRun.
enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

enum DiagnosticsMode {
  PRODUCTION
  TRACE
  FULL_DEBUG
}

enum DiagnosticsArtifactKind {
  TRACE
  SCREENSHOT
  HTML_SNAPSHOT
  CONSOLE_LOG
  NETWORK_HAR
  VIDEO
}

enum GenerationRunStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  SUCCESS
  FAILED
  CANCELLED
}

enum GenerationTrigger {
  MANUAL
  SELF_HEAL
  SCHEDULED
}

enum ComputerActionType {
  CLICK
  DOUBLE_CLICK
  TYPE
  SCROLL
  SCROLL_UP
  SCROLL_DOWN
  NAVIGATE
  GO_BACK
  CLOSE_TAB
  WAIT
  KEYPRESS
  SCREENSHOT
  DRAG
  DONE
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
  STALLED
}

enum ScraperVersionCreatedBy {
  AI
  USER
}

enum BlockSignal {
  BLOCKED
  CHALLENGE
}

enum BlockRuleSource {
  TITLE
  TEXT
  HTML
  PATH
  SCRIPT_CONTENT
  SELECTOR
}

enum NotificationType {
  QUEUE_FAILURE
  BROKEN_SCRAPER
  WEBSITE_UNAVAILABLE
  LARGE_CRAWL_FAILURE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IntegrationType {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
}

enum ComputerUseModel {
  CLAUDE_OPUS_4_8
  CLAUDE_SONNET_4_6
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  phone             String?  @unique
  password          String
  role              AuthRole
  crawl_schedule_tz String   @default("Europe/Athens")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  password_reset_tokens PasswordResetToken[]
  website_targets       WebsiteTarget[]
  scrapers              Scraper[]
  crawl_runs            CrawlRun[]
  user_integrations     UserIntegration[]
  extraction_schemas    ExtractionSchema[]
  browser_agent_configs BrowserAgentConfig[]
  browser_agent_runs    BrowserAgentRun[]
  plain_scrape_configs  PlainScrapeConfig[]
  plain_scrape_runs     PlainScrapeRun[]

  @@index([email])
  @@index([phone])
  @@index([id])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_id    String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Document {
  id         String       @id @default(uuid())
  user_id    String
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  type       DocumentType @default(LOGO)
  created_at DateTime     @default(now())

  computer_use_steps_before ComputerUseStep[] @relation("ComputerUseStepScreenshotBefore")
  computer_use_steps_after  ComputerUseStep[] @relation("ComputerUseStepScreenshotAfter")

  @@index([user_id])
  @@index([id])
  @@map("documents")
}

model WebsiteTarget {
  id                                   String    @id @default(uuid())
  user_id                              String
  name                                 String
  base_url                             String
  notes                                String?
  last_success_at                      DateTime?
  last_failure_at                      DateTime?
  last_error_message                   String?
  metadata                             Json?
  block_handling_wait_timeout_ms       Int?
  block_handling_min_ready_body_length Int?
  created_at                           DateTime  @default(now())
  updated_at                           DateTime  @updatedAt

  scrapers                Scraper[]
  scraper_generation_runs ScraperGenerationRun[]
  crawl_runs              CrawlRun[]
  block_rules             BlockRule[]
  notifications           Notification[]
  extracted_items         ExtractedItem[]

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, base_url])
  @@index([user_id])
  @@map("website_targets")
}

model BlockRule {
  id                String          @id @default(uuid())
  website_target_id String
  label             String?
  signal            BlockSignal
  source            BlockRuleSource
  pattern           String
  is_regex          Boolean         @default(false)
  regex_flags       String?
  position          Int             @default(0)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  website_target WebsiteTarget @relation(fields: [website_target_id], references: [id], onDelete: Cascade)

  @@index([website_target_id])
  @@map("block_rules")
}

model Scraper {
  id                   String          @id @default(uuid())
  user_id              String
  website_target_id    String
  name                 String
  active_version_id    String?         @unique
  version_count        Int             @default(0)
  status               ScraperStatus   @default(TESTING)
  self_healing_enabled Boolean         @default(true)
  diagnostics_mode     DiagnosticsMode @default(PRODUCTION)
  health               ScraperHealth   @default(GOOD)
  success_rate         Decimal?        @db.Decimal(5, 2)
  avg_runtime_ms       Int?
  consecutive_failures Int             @default(0)
  last_success_at      DateTime?
  last_failure_at      DateTime?
  // Scheduling is a property of this saved configuration, not of the WebsiteTarget or a
  // separate parallel concept — a standard cron expression evaluated in schedule_timezone.
  schedule_cron        String?
  schedule_timezone    String?
  schedule_enabled     Boolean         @default(false)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  website_target WebsiteTarget   @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_version ScraperVersion? @relation("ActiveVersion", fields: [active_version_id], references: [id], onDelete: SetNull)

  crawl_runs              CrawlRun[]
  versions                ScraperVersion[]        @relation("ScraperVersions")
  execution_traces        ScraperExecutionTrace[]
  scraper_generation_runs ScraperGenerationRun[]
  notifications           Notification[]
  diagnostics_packages    DiagnosticsPackage[]

  @@index([user_id])
  @@index([website_target_id])
  @@index([status])
  @@index([health])
  @@map("scrapers")
}

model ScraperGenerationRun {
  id                  String              @id @default(uuid())
  website_target_id   String
  scraper_id          String?
  trigger             GenerationTrigger   @default(MANUAL)
  status              GenerationRunStatus @default(QUEUED)
  prompt              String?
  max_steps           Int?
  staged_config       Json?
  produced_version_id String?             @unique
  error_message       String?
  started_at          DateTime?
  finished_at         DateTime?
  duration_ms         Int?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  website_target   WebsiteTarget   @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  scraper          Scraper?        @relation(fields: [scraper_id], references: [id], onDelete: SetNull)
  produced_version ScraperVersion? @relation("ProducedVersion", fields: [produced_version_id], references: [id], onDelete: SetNull)

  steps ComputerUseStep[]

  @@index([website_target_id])
  @@index([scraper_id])
  @@index([status])
  @@map("scraper_generation_runs")
}

// A single Computer Use step, belonging to exactly one of: a ScraperGenerationRun (discovering
// how to build a reusable scraper) or a BrowserAgentRun (a one-off dynamic browser task).
model ComputerUseStep {
  id                        String             @id @default(uuid())
  scraper_generation_run_id String?
  browser_agent_run_id      String?
  step_index                Int
  action_type               ComputerActionType
  action_payload            Json
  screenshot_before_id      String?
  screenshot_after_id       String?
  model_reasoning           String?
  created_at                DateTime           @default(now())

  scraper_generation_run ScraperGenerationRun? @relation(fields: [scraper_generation_run_id], references: [id], onDelete: Cascade)
  browser_agent_run      BrowserAgentRun?      @relation(fields: [browser_agent_run_id], references: [id], onDelete: Cascade)
  screenshot_before      Document?             @relation("ComputerUseStepScreenshotBefore", fields: [screenshot_before_id], references: [id], onDelete: SetNull)
  screenshot_after       Document?             @relation("ComputerUseStepScreenshotAfter", fields: [screenshot_after_id], references: [id], onDelete: SetNull)

  @@index([scraper_generation_run_id])
  @@index([scraper_generation_run_id, step_index])
  @@index([browser_agent_run_id])
  @@index([browser_agent_run_id, step_index])
  @@map("computer_use_steps")
}

model ScraperVersion {
  id         String                  @id @default(uuid())
  scraper_id String
  version    Int
  // Fixed/reusable scraper configuration or sequence of scraper steps (Computer-Use-generated
  // or CSS-selector-based) produced from generation_prompt. Opaque to Prisma by design.
  config     Json
  created_by ScraperVersionCreatedBy
  notes      String?

  // Free-text scraper-generation instructions this version was built from (e.g. "Navigate to the
  // properties page, iterate through every listing..."). Reused verbatim as the guiding prompt for
  // MARKDOWN normalization at execution time — kept on the version (not just the generation run)
  // so it stays available even when the producing ScraperGenerationRun is absent or pruned.
  generation_prompt String?

  // Output contract this version is expected to produce. STRUCTURED_JSON requires
  // extraction_schema_version_id; MARKDOWN needs no schema. Both may be set.
  output_formats               OutputFormat[]
  extraction_schema_version_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  scraper                   Scraper                  @relation("ScraperVersions", fields: [scraper_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)

  active_for_scraper Scraper?              @relation("ActiveVersion")
  produced_by_run    ScraperGenerationRun? @relation("ProducedVersion")
  crawl_runs         CrawlRun[]

  @@unique([scraper_id, version])
  @@index([extraction_schema_version_id])
  @@map("scraper_versions")
}

model ScraperExecutionTrace {
  id            String   @id @default(uuid())
  scraper_id    String
  crawl_run_id  String?
  steps         Json
  success       Boolean
  error_summary String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  scraper   Scraper   @relation(fields: [scraper_id], references: [id], onDelete: Cascade)
  crawl_run CrawlRun? @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([scraper_id])
  @@map("scraper_execution_traces")
}

model CrawlRun {
  id                 String     @id @default(uuid())
  user_id            String
  website_target_id  String
  scraper_id         String
  // Exact ScraperVersion this run executed against — pins the config, generation_prompt,
  // output_formats, and extraction_schema_version_id for this run, independently of whatever
  // version the Scraper's active_version_id later points to.
  scraper_version_id String
  trigger            RunTrigger @default(MANUAL)
  status             RunStatus  @default(QUEUED)
  started_at         DateTime?
  finished_at        DateTime?
  duration_ms        Int?
  error_message      String?
  metadata           Json?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  website_target      WebsiteTarget           @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  scraper             Scraper                 @relation(fields: [scraper_id], references: [id], onDelete: Cascade)
  scraper_version     ScraperVersion          @relation(fields: [scraper_version_id], references: [id], onDelete: Cascade)
  job_logs            JobLog[]
  execution_traces    ScraperExecutionTrace[]
  notifications       Notification[]
  diagnostics_package DiagnosticsPackage?
  extracted_items     ExtractedItem[]
  extraction_result   ExtractionResult?

  @@index([user_id])
  @@index([website_target_id])
  @@index([scraper_id])
  @@index([scraper_version_id])
  @@index([status])
  @@index([created_at])
  @@map("crawl_runs")
}

model ExtractedItem {
  id                String   @id @default(uuid())
  website_target_id String
  crawl_run_id      String?
  source_url        String
  external_id       String?
  raw_data          Json
  content_hash      String?
  first_seen_at     DateTime @default(now())
  last_seen_at      DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  website_target WebsiteTarget @relation(fields: [website_target_id], references: [id], onDelete: Cascade)
  crawl_run      CrawlRun?     @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@unique([website_target_id, source_url])
  @@index([crawl_run_id])
  @@map("extracted_items")
}

// ---------------------------------------------------------------------------
// App-Defined Output Schema (Shared Concept)
//
// Reusable, user-owned, versioned representation of the expected STRUCTURED_JSON output shape.
// Referenced (never duplicated) by whichever workflow needs it: ScraperVersion, BrowserAgentConfig
// / BrowserAgentRun, PlainScrapeConfig / PlainScrapeRun. Versions are immutable — a config's FK is
// free to move to a newer version, but each run snapshots the version it actually executed against,
// so changing a schema later can never make a historical run's result ambiguous.
// ---------------------------------------------------------------------------

model ExtractionSchema {
  id                String   @id @default(uuid())
  user_id           String
  name              String
  description       String?
  active_version_id String?  @unique
  version_count     Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user           User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_version ExtractionSchemaVersion?  @relation("ActiveExtractionSchemaVersion", fields: [active_version_id], references: [id], onDelete: SetNull)
  versions       ExtractionSchemaVersion[] @relation("ExtractionSchemaVersions")

  @@index([user_id])
  @@map("extraction_schemas")
}

model ExtractionSchemaVersion {
  id                   String   @id @default(uuid())
  extraction_schema_id String
  version              Int
  // The application-level schema representation: a dynamic, user-defined map of field name ->
  // { type: string | number | integer | boolean | string[] | number[] | boolean[] | object |
  //          object[] | enum | ..., description?, required?, nullable?, enum?, pattern?,
  //          minimum?, maximum?, minLength?, maxLength?, items? (array element schema),
  //          properties? (nested object schema) }.
  // Converted to the AI provider's structured-output/JSON Schema format at execution time —
  // never hardcoded around specific fields.
  definition           Json
  created_at           DateTime @default(now())

  extraction_schema ExtractionSchema  @relation("ExtractionSchemaVersions", fields: [extraction_schema_id], references: [id], onDelete: Cascade)
  active_for_schema ExtractionSchema? @relation("ActiveExtractionSchemaVersion")

  scraper_versions      ScraperVersion[]
  browser_agent_configs BrowserAgentConfig[]
  browser_agent_runs    BrowserAgentRun[]
  plain_scrape_configs  PlainScrapeConfig[]
  plain_scrape_runs     PlainScrapeRun[]
  extraction_results    ExtractionResult[]

  @@unique([extraction_schema_id, version])
  @@map("extraction_schema_versions")
}

// ---------------------------------------------------------------------------
// Workflow 2: Dynamic Browser / Computer Vision Extraction
//
// One-off Computer Use + Playwright tasks with no fixed navigation steps. Still persisted as a
// saved, reusable, schedulable configuration (per the on-demand & scheduled execution
// requirement) — BrowserAgentRun is one execution of a BrowserAgentConfig.
// ---------------------------------------------------------------------------

model BrowserAgentConfig {
  id      String @id @default(uuid())
  user_id String
  name    String
  url     String

  // Required output contract for every run of this config. STRUCTURED_JSON requires
  // extraction_schema_version_id; MARKDOWN alone needs no schema.
  output_formats               OutputFormat[]
  extraction_schema_version_id String?

  schedule_cron     String?
  schedule_timezone String?
  schedule_enabled  Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  runs                      BrowserAgentRun[]

  @@index([user_id])
  @@index([extraction_schema_version_id])
  @@map("browser_agent_configs")
}

model BrowserAgentRun {
  id                      String     @id @default(uuid())
  browser_agent_config_id String
  user_id                 String
  trigger                 RunTrigger @default(MANUAL)
  status                  RunStatus  @default(QUEUED)

  // Snapshot of the config's contract at the moment this run was launched, so later edits to
  // the BrowserAgentConfig never change what a historical run is understood to have targeted.
  url                          String
  output_formats               OutputFormat[]
  extraction_schema_version_id String?

  visited_urls    Json?
  browser_actions Json?
  collected_data  Json?
  ai_usage        Json?
  error_message   String?

  started_at  DateTime?
  finished_at DateTime?
  duration_ms Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  browser_agent_config      BrowserAgentConfig       @relation(fields: [browser_agent_config_id], references: [id], onDelete: Cascade)
  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  steps                     ComputerUseStep[]
  extraction_result         ExtractionResult?

  @@index([browser_agent_config_id])
  @@index([user_id])
  @@index([status])
  @@index([extraction_schema_version_id])
  @@map("browser_agent_runs")
}

// ---------------------------------------------------------------------------
// Workflow 3: Plain HTML / Website Content Scraping
//
// Lightweight multi-URL scraping with no Computer Use / computer vision. AI normalization
// (STRUCTURED_JSON and/or MARKDOWN) is entirely optional. Saved as a reusable, schedulable
// configuration like the other two workflows.
// ---------------------------------------------------------------------------

model PlainScrapeConfig {
  id      String   @id @default(uuid())
  user_id String
  name    String
  urls    String[]

  // Absent/empty output_formats means "raw scraping only" — no AI normalization runs.
  output_formats               OutputFormat[]
  extraction_schema_version_id String?
  // Whether multiple URLs are treated as one combined extraction task (default) or extracted
  // per-URL. Applies to both STRUCTURED_JSON and MARKDOWN normalization.
  extraction_scope             ExtractionScope @default(COMBINED)

  schedule_cron     String?
  schedule_timezone String?
  schedule_enabled  Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  runs                      PlainScrapeRun[]

  @@index([user_id])
  @@index([extraction_schema_version_id])
  @@map("plain_scrape_configs")
}

model PlainScrapeRun {
  id                     String     @id @default(uuid())
  plain_scrape_config_id String
  user_id                String
  trigger                RunTrigger @default(MANUAL)
  status                 RunStatus  @default(QUEUED)

  // Snapshot of the config's contract at the moment this run was launched.
  urls                         String[]
  output_formats               OutputFormat[]
  extraction_schema_version_id String?
  extraction_scope             ExtractionScope @default(COMBINED)

  error_message String?
  ai_usage      Json?

  started_at  DateTime?
  finished_at DateTime?
  duration_ms Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  plain_scrape_config       PlainScrapeConfig        @relation(fields: [plain_scrape_config_id], references: [id], onDelete: Cascade)
  user                      User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)
  pages                     PlainScrapedPage[]
  // Populated when extraction_scope is COMBINED (one result for all pages together).
  extraction_result         ExtractionResult?

  @@index([plain_scrape_config_id])
  @@index([user_id])
  @@index([status])
  @@index([extraction_schema_version_id])
  @@map("plain_scrape_runs")
}

// Raw per-URL fetch result — always populated, independently of whether normalization was requested.
model PlainScrapedPage {
  id                  String   @id @default(uuid())
  plain_scrape_run_id String
  requested_url       String
  final_url           String?
  http_status         Int?
  success             Boolean  @default(false)
  raw_html            String?
  cleaned_content     String?
  title               String?
  metadata            Json?
  error_message       String?
  created_at          DateTime @default(now())

  plain_scrape_run  PlainScrapeRun    @relation(fields: [plain_scrape_run_id], references: [id], onDelete: Cascade)
  // Populated when the parent run's extraction_scope is PER_URL (one result per page).
  extraction_result ExtractionResult?

  @@index([plain_scrape_run_id])
  @@map("plain_scraped_pages")
}

// ---------------------------------------------------------------------------
// Structured Extraction Pipeline (Shared Concept): normalized results
//
// One row per "thing that got normalized" — a CrawlRun, a BrowserAgentRun, a COMBINED
// PlainScrapeRun, or a single PlainScrapedPage under a PER_URL PlainScrapeRun. Exactly one of
// the four owner FKs is set. STRUCTURED_JSON and MARKDOWN are independently-failable outputs of
// the same underlying run, never overwriting each other and never forcing an all-or-nothing
// discriminator — either, both, or (on total failure) neither payload may be present.
// ---------------------------------------------------------------------------

model ExtractionResult {
  id String @id @default(uuid())

  crawl_run_id          String? @unique
  browser_agent_run_id  String? @unique
  plain_scrape_run_id   String? @unique
  plain_scraped_page_id String? @unique

  // The exact schema version this result was validated against (STRUCTURED_JSON only).
  extraction_schema_version_id String?

  structured_status            ExtractionFormatStatus?
  structured_data              Json?
  // Last generated (possibly still-invalid) output, preserved for debugging even on failure.
  structured_raw_ai_output     Json?
  structured_validation_errors Json?
  structured_attempts          Int                     @default(0)

  markdown_status            ExtractionFormatStatus?
  markdown                   String?
  markdown_validation_errors Json?

  ai_usage   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  crawl_run                 CrawlRun?                @relation(fields: [crawl_run_id], references: [id], onDelete: Cascade)
  browser_agent_run         BrowserAgentRun?         @relation(fields: [browser_agent_run_id], references: [id], onDelete: Cascade)
  plain_scrape_run          PlainScrapeRun?          @relation(fields: [plain_scrape_run_id], references: [id], onDelete: Cascade)
  plain_scraped_page        PlainScrapedPage?        @relation(fields: [plain_scraped_page_id], references: [id], onDelete: Cascade)
  extraction_schema_version ExtractionSchemaVersion? @relation(fields: [extraction_schema_version_id], references: [id], onDelete: SetNull)

  @@index([extraction_schema_version_id])
  @@map("extraction_results")
}

model DiagnosticsPackage {
  id                 String          @id @default(uuid())
  crawl_run_id       String          @unique
  scraper_id         String
  mode               DiagnosticsMode
  url                String
  worker_id          String?
  browser_version    String?
  playwright_version String?
  scraper_version    Int?
  retry_number       Int?
  started_at         DateTime
  finished_at        DateTime
  duration_ms        Int
  failure_reason     String?
  exception          String?
  created_at         DateTime        @default(now())

  crawl_run CrawlRun              @relation(fields: [crawl_run_id], references: [id], onDelete: Cascade)
  scraper   Scraper               @relation(fields: [scraper_id], references: [id], onDelete: Cascade)
  artifacts DiagnosticsArtifact[]

  @@index([scraper_id])
  @@map("diagnostics_packages")
}

model DiagnosticsArtifact {
  id                     String                  @id @default(uuid())
  diagnostics_package_id String
  kind                   DiagnosticsArtifactKind
  path                   String
  content_type           String
  size_bytes             Int
  created_at             DateTime                @default(now())

  diagnostics_package DiagnosticsPackage @relation(fields: [diagnostics_package_id], references: [id], onDelete: Cascade)

  @@index([diagnostics_package_id])
  @@map("diagnostics_artifacts")
}

model JobLog {
  id            String    @id @default(uuid())
  queue_name    String
  job_id        String?
  job_name      String?
  status        JobStatus
  attempt       Int       @default(0)
  max_attempts  Int?
  crawl_run_id  String?
  payload       Json?
  result        Json?
  error_message String?
  stack_trace   String?
  started_at    DateTime?
  finished_at   DateTime?
  duration_ms   Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  crawl_run CrawlRun? @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([queue_name])
  @@index([job_id])
  @@index([status])
  @@index([crawl_run_id])
  @@index([created_at])
  @@map("job_logs")
}

model Notification {
  id                String               @id @default(uuid())
  type              NotificationType
  severity          NotificationSeverity @default(INFO)
  title             String
  message           String
  website_target_id String?
  scraper_id        String?
  crawl_run_id      String?
  is_read           Boolean              @default(false)
  created_at        DateTime             @default(now())

  website_target WebsiteTarget? @relation(fields: [website_target_id], references: [id], onDelete: SetNull)
  scraper        Scraper?       @relation(fields: [scraper_id], references: [id], onDelete: SetNull)
  crawl_run      CrawlRun?      @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([severity])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

model UserIntegration {
  id                    String            @id @default(uuid())
  user_id               String
  integration_type      IntegrationType
  computer_use_model    ComputerUseModel?
  credentials_encrypted String
  is_active             Boolean           @default(true)
  metadata              Json?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, integration_type])
  @@index([user_id])
  @@index([integration_type])
  @@index([is_active])
  @@map("user_integrations")
}

model PlatformConfig {
  id                                           String   @id @default("singleton")
  crawler_max_pages                            Int?
  crawler_page_timeout_ms                      Int?
  crawler_selector_timeout_ms                  Int?
  crawler_scroll_pause_ms                      Int?
  crawler_detail_concurrency                   Int?
  crawler_detail_delay_ms                      Int?
  crawler_worker_concurrency                   Int?
  crawler_job_timeout_ms                       Int?
  crawler_chromium_max_contexts_before_restart Int?
  created_at                                   DateTime @default(now())
  updated_at                                   DateTime @updatedAt

  @@map("platform_config")
}
